{
  "name": "pet-projects",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:portal": "pnpm --filter portal dev",
    "dev:polyline": "pnpm --filter polyline dev",
    "dev:img2pdf": "pnpm --filter img2pdf dev",
    "dev:sticky-wall": "pnpm --filter sticky-wall dev",
    "dev:dither-photo": "pnpm --filter dither-photo dev",
    "build": "pnpm -r --filter \"./apps/**\" build && node scripts/assemble.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
